# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000

# Example production URL (uncomment and modify for production)
# NEXT_PUBLIC_API_URL=https://api.opendiving.com

# Google Sign-In (OAuth 2.0 client ID from the Google Cloud Console, "Web application"
# type). Not a secret - safe to expose to the browser. Leave unset to hide the
# "Continue with Google" button. Must match the API's GOOGLE_CLIENT_ID.
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
