# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# Claude Code working directory (agent worktrees, launch config). Hundreds of MB
# of scratch checkouts - never wanted in a commit or a Docker build context.
# The hook config is the exception: agents work in fresh worktree checkouts, so a
# rule that stays uncommitted never reaches the sessions it is meant to constrain.
# That is also why the pattern is `.claude/*` - git cannot re-include a path whose
# parent directory is excluded outright.
.claude/*
!.claude/settings.json
!.claude/hooks/
# Re-including the directory re-includes whatever Python leaves in it. The api
# repo ignores this globally; a JavaScript repo has no reason to, until now.
.claude/hooks/__pycache__/

# Playwright MCP server scratch output (accessibility snapshots, console logs).
.playwright-mcp/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
